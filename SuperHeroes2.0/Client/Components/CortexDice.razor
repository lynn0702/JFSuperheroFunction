@using SuperHeroes.Client.Services
@using SuperHeroes.Client.Models
@inject DiceThemeService ThemeService
@implements IDisposable

<div class="cortex-dice-wrapper @CssWrapper @(Interactive ? "interactive-die" : "")"
     @onclick="HandleClick"
     @oncontextmenu="HandleContextMenu"
     @oncontextmenu:preventDefault="Interactive">

    @if (!string.IsNullOrEmpty(LabelText) && LabelPosition.Equals("left", StringComparison.OrdinalIgnoreCase))
    {
        <span class="dice-label @LabelCss">@LabelText</span>
    }

    <div class="dice-svg-container @Css" style="width: @CalculatedSize; height: @CalculatedHeight; display: inline-flex; align-items: center; justify-content: center;">
        @switch (Die)
        {
            case 2:
                <svg viewBox="0 0 512 400" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" class="cortex-svg-die d2-svg">
                    <g transform="translate(25, -20) scale(0.9, 0.9)">
                        <path d="M247 65.16L32.34 440.8l61.79-35.7L247 137.6zm18 .38V137l158.3 271.3 62.7 36.1C412.2 318.2 338.6 191.8 265 65.54zM415.4 424.5l-321.3 1.4-62.72 36.2 445.82-1.9z"
                              fill="@EffectiveFillColor"
                              stroke="@EffectiveStrokeColor"
                              stroke-width="@(EffectiveStrokeWidth * 5)" />
                    </g>
                </svg>
                break;

            case 4:
                <svg viewBox="0.0 0.0 290 230" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" class="cortex-svg-die d4-svg">
                    <g>
                        <path fill="@EffectiveFillColor"
                              stroke="@EffectiveStrokeColor"
                              stroke-width="@EffectiveStrokeWidth"
                              stroke-linejoin="round"
                              stroke-linecap="butt"
                              d="m34.5853 9.682415l110.99213 206.67715l110.99213 -206.67715z" />
                        <path fill="@EffectiveTextColor"
                              d="m150.11778 128.66792l0 -21.937492l-39.75 0l0 -10.3125l41.8125 -59.375004l9.1875 0l0 59.375004l12.375 0l0 10.3125l-12.375 0l0 21.937492l-11.25 0zm0 -32.249992l0 -41.312504l-28.6875 41.312504l28.6875 0z" />
                    </g>
                </svg>
                break;

            case 6:
                <svg viewBox="0.0 0.0 290 230" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" class="cortex-svg-die d6-svg">
                    <g>
                        <rect x="80" y="35" width="160" height="160" rx="6"
                              fill="@EffectiveFillColor"
                              stroke="@EffectiveStrokeColor"
                              stroke-width="@EffectiveStrokeWidth"
                              stroke-linejoin="round"
                              stroke-linecap="butt" />
                        <path fill="@EffectiveTextColor"
                              d="m172.00787 67.8385l0 9.8125l-2.125 0q-13.5 0.25 -21.5 8.0q-8.0 7.75 -9.25 21.8125q7.1875 -8.25 19.625 -8.25q11.875 0 18.96875 8.375q7.09375 8.375 7.09375 21.625q0 14.0625 -7.65625 22.5q-7.65625 8.4375 -20.53125 8.4375q-13.0625 0 -21.1875 -10.03125q-8.125 -10.03125 -8.125 -25.84375l0 -4.4375q0 -25.125 10.71875 -38.40625q10.71875 -13.28125 31.90625 -13.59375l2.0625 0zm-15.1875 41.0q-5.9375 0 -10.9375 3.5625q-5.0 3.5625 -6.9375 8.9375l0 4.25q0 11.25 5.0625 18.125q5.0625 6.875 12.625 6.875q7.8125 0 12.28125 -5.75q4.46875 -5.75 4.46875 -15.0625q0 -9.375 -4.53125 -15.15625q-4.53125 -5.78125 -12.03125 -5.78125z" />
                    </g>
                </svg>
                break;

            case 8:
                <svg viewBox="0.0 0.0 290 230" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" class="cortex-svg-die d8-svg">
                    <g>
                        <path fill="@EffectiveFillColor"
                              stroke="@EffectiveStrokeColor"
                              stroke-width="@EffectiveStrokeWidth"
                              stroke-linejoin="round"
                              stroke-linecap="butt"
                              d="m57.51181 113.020996l87.88977 92.53543l87.889755 -92.53543l-87.889755 -92.53543z" />
                        <path fill="@EffectiveTextColor"
                              d="m131.0922 105.53948q-7.0 -2.5625 -10.375 -7.3125q-3.375 -4.75 -3.375 -11.375q0 -10.0 7.1875 -16.8125q7.1875 -6.8125 19.125 -6.8125q12.0 0 19.3125 6.96875q7.3125 6.96875 7.3125 16.96875q0 6.375 -3.34375 11.09375q-3.34375 4.71875 -10.15625 7.28125q8.4375 2.75 12.84375 8.875q4.40625 6.125 4.40625 14.625008q0 11.75 -8.3125 19.75q-8.3125 8.0 -21.875 8.0q-13.5625 0 -21.875 -8.03125q-8.3125 -8.03125 -8.3125 -20.03125q0 -8.937508 4.53125 -14.968758q4.53125 -6.03125 12.90625 -8.21875zm-2.25 -19.0625q0 6.5 4.1875 10.625q4.1875 4.125 10.875 4.125q6.5 0 10.65625 -4.09375q4.15625 -4.09375 4.15625 -10.03125q0 -6.1875 -4.28125 -10.40625q-4.28125 -4.21875 -10.65625 -4.21875q-6.4375 0 -10.6875 4.125q-4.25 4.125 -4.25 9.875zm-3.625 42.312508q0 4.8125 2.28125 9.3125q2.28125 4.5 6.78125 6.96875q4.5 2.46875 9.6875 2.46875q8.0625 0 13.3125 -5.1875q5.25 -5.1875 5.25 -13.1875q0 -8.125008 -5.40625 -13.437508q-5.40625 -5.3125 -13.53125 -5.3125q-7.9375 0 -13.15625 5.25q-5.21875 5.25 -5.21875 13.125008z" />
                    </g>
                </svg>
                break;

            case 10:
                <svg viewBox="0.0 0.0 290 230" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" class="cortex-svg-die d10-svg">
                    <g>
                        <path fill="@EffectiveFillColor"
                              stroke="@EffectiveStrokeColor"
                              stroke-width="@EffectiveStrokeWidth"
                              stroke-linejoin="round"
                              stroke-linecap="butt"
                              d="m145.40158 9.682415l-92.5354 73.87474l0 59.21116l92.5354 73.87474l92.535385 -73.87474l0 -59.21116z" />
                        <path fill="@EffectiveTextColor"
                              d="m121.90157 159.101l-11.25 0l0 -71.6875q-4.0625 3.875 -10.65625 7.75q-6.59375 3.875 -11.84375 5.8125l0 -10.875q9.4375 -4.4375 16.5 -10.75q7.0625 -6.3125 10.0 -12.25l7.25 0l0 92.0zm28.812492 -45.1875q0 -16.25 3.34375 -26.15625q3.34375 -9.90625 9.9375 -15.28125q6.59375 -5.375 16.59375 -5.375q7.375 0 12.9375 2.96875q5.5625 2.96875 9.1875 8.5625q3.625 5.59375 5.6875 13.625q2.0625 8.03125 2.0625 21.65625q0 16.125 -3.3125 26.03125q-3.3125 9.90625 -9.90625 15.3125q-6.59375 5.40625 -16.65625 5.40625q-13.25 0 -20.8125 -9.5q-9.0625 -11.4375 -9.0625 -37.25zm11.5625 0q0 22.5625 5.28125 30.03125q5.28125 7.46875 13.03125 7.46875q7.75 0 13.03125 -7.5q5.28125 -7.5 5.28125 -30.0q0 -22.625 -5.28125 -30.0625q-5.28125 -7.4375 -13.15625 -7.4375q-7.75 0 -12.375 6.5625q-5.8125 8.375 -5.8125 30.9375z" />
                    </g>
                </svg>
                break;

            case 12:
                <svg viewBox="0.0 0.0 290 230" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" class="cortex-svg-die d12-svg">
                    <g>
                        <path fill="@EffectiveFillColor"
                              stroke="@EffectiveStrokeColor"
                              stroke-width="@EffectiveStrokeWidth"
                              stroke-linejoin="round"
                              stroke-linecap="butt"
                              d="m145.40158 9.682415l-57.189926 19.762981l-35.345318 51.740158l0 63.954353l35.345318 51.740158l57.189926 19.762985l57.18991 -19.762985l35.34532 -51.740158l0 -63.954353l-35.34532 -51.740158z" />
                        <path fill="@EffectiveTextColor"
                              d="m112.232285 155.22437l-11.25 0l0 -71.68751q-4.0625 3.875 -10.65625 7.75q-6.59375 3.875 -11.84375 5.8125l0 -10.875q9.4375 -4.4375 16.5 -10.75q7.0625 -6.3125 10.0 -12.25l7.25 0l0 92.00001zm87.9375 -10.8125l0 10.8125l-60.5625 0q-0.125 -4.0625 1.3125 -7.8125q2.3125 -6.1875 7.40625 -12.1875q5.09375 -6.0 14.71875 -13.875008q14.9375 -12.25 20.1875 -19.40625q5.25 -7.15625 5.25 -13.53125q0 -6.6875 -4.78125 -11.28125q-4.78125 -4.59375 -12.46875 -4.59375q-8.125 0 -13.0 4.875q-4.875 4.875 -4.9375 13.5l-11.5625 -1.1875q1.1875 -12.9375 8.9375 -19.71875q7.75 -6.78125 20.8125 -6.78125q13.1875 0 20.875 7.3125q7.6875 7.3125 7.6875 18.125q0 5.5 -2.25 10.8125q-2.25 5.3125 -7.46875 11.1875q-5.21875 5.875 -17.34375 16.125q-10.125 8.500008 -13.0 11.531258q-2.875 3.03125 -4.75 6.09375l44.9375 0z" />
                    </g>
                </svg>
                break;

            default:
                <span class="dice-fallback">d@(Die)</span>
                break;
        }
    </div>

    @if (!string.IsNullOrEmpty(LabelText) && LabelPosition.Equals("right", StringComparison.OrdinalIgnoreCase))
    {
        <span class="dice-label @LabelCss">@LabelText</span>
    }
</div>

@code {
    [Parameter] public int Die { get; set; } = 8;
    [Parameter] public EventCallback<int> DieChanged { get; set; }

    // Color overrides (if null, inherited from ThemeService)
    [Parameter] public string? FillColor { get; set; }
    [Parameter] public string? StrokeColor { get; set; }
    [Parameter] public string? TextColor { get; set; }
    [Parameter] public double? StrokeWidth { get; set; }

    // Size / Styling
    [Parameter] public string Size { get; set; } = "medium"; // "small", "medium", "large", "xlarge", or custom "48px"
    [Parameter] public string Css { get; set; } = "";
    [Parameter] public string CssWrapper { get; set; } = "";
    [Parameter] public string LabelText { get; set; } = "";
    [Parameter] public string LabelCss { get; set; } = "";
    [Parameter] public string LabelPosition { get; set; } = "left"; // "left" or "right"
    [Parameter] public bool Interactive { get; set; } = false;

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string EffectiveFillColor =>
        !string.IsNullOrEmpty(FillColor) ? FillColor : ThemeService.CurrentTheme.GetColorForDie(Die);

    private string EffectiveStrokeColor =>
        !string.IsNullOrEmpty(StrokeColor) ? StrokeColor : ThemeService.CurrentTheme.StrokeColor;

    private string EffectiveTextColor =>
        !string.IsNullOrEmpty(TextColor) ? TextColor : ThemeService.CurrentTheme.TextColor;

    private double EffectiveStrokeWidth =>
        StrokeWidth ?? ThemeService.CurrentTheme.StrokeWidth;

    private string CalculatedSize => Size switch
    {
        "small" => "28px",
        "medium" => "42px",
        "large" => "58px",
        "xlarge" => "80px",
        _ => Size.EndsWith("px") || Size.EndsWith("rem") || Size.EndsWith("%") ? Size : "42px"
    };

    private string CalculatedHeight => Size switch
    {
        "small" => "22px",
        "medium" => "34px",
        "large" => "46px",
        "xlarge" => "64px",
        _ => Size.EndsWith("px") || Size.EndsWith("rem") || Size.EndsWith("%") ? Size : "34px"
    };

    private async Task HandleClick()
    {
        if (!Interactive) return;
        Die = Die < 12 ? Die + 2 : 2;
        await DieChanged.InvokeAsync(Die);
    }

    private async Task HandleContextMenu()
    {
        if (!Interactive) return;
        Die = Die > 2 ? Die - 2 : 12;
        await DieChanged.InvokeAsync(Die);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
